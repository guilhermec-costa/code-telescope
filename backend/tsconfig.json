{
    "compilerOptions": {
        "composite": true,
        "module": "Node16",
        "moduleResolution": "node16",
        "target": "ES2022",
        "outDir": "./dist",
        "lib": ["ES2022"],
        "sourceMap": true,
        "types": ["mocha"],
        "rootDir": ".",
        "paths": {
            "@shared/*": ["../shared/*"],
            "@backend/*": ["./*"]
        },
        "strict": true,
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": ["./**/*", "./**/*.json", "../shared/**/*"],
    "exclude": ["./dist"]
}
