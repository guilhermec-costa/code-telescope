{
    "name": "code-telescope-sandbox",
    "displayName": "Code Telescope Sandbox",
    "description": "Sandbox for testing Code Telescope external API",
    "version": "0.0.1",
    "publisher": "sandbox",
    "engines": {
        "vscode": "^1.80.0"
    },
    "extensionDependencies": [
        "guichina.code-telescope"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
      "commands": {
        "command": "sandbox.openWorkspaceFolders",
        "title": "Code Telescope Sandbox: Workspace Folders"
      }
    },
    "main": "./out/extension.js",
    "scripts": {
        "compile": "tsc -p tsconfig.json",
        "watch": "tsc -watch -p tsconfig.json"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "typescript": "^5.0.0"
    }
}
